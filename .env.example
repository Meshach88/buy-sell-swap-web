# Base URL the web app sends API requests to. Left unset, it falls back to
# '/api' (see src/lib/api.js), which only works in dev because vite.config.js
# proxies '/api' to the local Laravel server. Set this explicitly when pointing
# at a different host, or for any production build (Vite env vars are baked in
# at build time, so this must be set before running `npm run build`).
VITE_API_URL=http://localhost:8000/api
